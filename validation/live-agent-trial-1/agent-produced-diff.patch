+"""UI shell: P1 placeholder + P2 three-space progressive disclosure."""
+
+SPACES = ("focus", "explore", "manage")
+
+
+def go_to_space(space: str) -> str:
+    """Route to one of the three P2 spaces. Raises ValueError if unknown."""
+    if space not in SPACES:
+        raise ValueError(f"Unknown space: {space!r}; expected one of {SPACES}")
+    return f"space:{space}"
+
+
+def render_p2_shell(active_space: str = "focus") -> dict:
+    """
+    Three-space progressive-disclosure shell replacing seven-tab top nav.
+
+    Returns a structured layout descriptor with the active space resolved
+    via go_to_space().
+    """
+    route = go_to_space(active_space)
+    return {
+        "layout": "three-space-progressive-disclosure",
+        "spaces": list(SPACES),
+        "active": active_space,
+        "route": route,
+        "nav": "space-switcher",  # replaces seven-tab top navigation
+    }
+
+
 def render_shell():
     return "P1 shell placeholder"
