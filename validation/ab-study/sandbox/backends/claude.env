# Backend: Claude via Claude Code (headless). Sourced by run-batch.sh after
# secrets.env, which must define ANTHROPIC_API_KEY.
# stream-json + verbose puts every tool call in the transcript; M1/M2 depend
# on seeing whether the agent read the artifact.
CLAUDE_MODEL="${CLAUDE_MODEL:-claude-sonnet-5}"
AB_MODEL="anthropic:$CLAUDE_MODEL"
AB_AGENT_CMD="claude -p --output-format stream-json --verbose --permission-mode bypassPermissions --model $CLAUDE_MODEL"
