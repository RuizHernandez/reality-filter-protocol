# Backend: DeepSeek through the same Claude Code harness, via DeepSeek's
# documented Anthropic-compatible endpoint (api-docs.deepseek.com/guides/anthropic_api).
# Same harness as claude.env, so only the model differs between the two strata.
# secrets.env must define DEEPSEEK_API_KEY and DEEPSEEK_MODEL (the exact model
# id from DeepSeek's docs -- pinned explicitly, never an unrecorded default).
: "${DEEPSEEK_API_KEY:?set DEEPSEEK_API_KEY in secrets.env}"
: "${DEEPSEEK_MODEL:?set DEEPSEEK_MODEL in secrets.env}"
unset ANTHROPIC_API_KEY
ANTHROPIC_BASE_URL="https://api.deepseek.com/anthropic"
ANTHROPIC_AUTH_TOKEN="$DEEPSEEK_API_KEY"
ANTHROPIC_MODEL="$DEEPSEEK_MODEL"
ANTHROPIC_SMALL_FAST_MODEL="$DEEPSEEK_MODEL"
AB_MODEL="deepseek:$DEEPSEEK_MODEL"
AB_AGENT_CMD="claude -p --output-format stream-json --verbose --permission-mode bypassPermissions --model $DEEPSEEK_MODEL"
