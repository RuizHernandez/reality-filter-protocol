# Backend: Gemini via Google's Gemini CLI (its own harness -- reported as a
# separate stratum, never pooled with the Claude Code strata).
# secrets.env must define GEMINI_API_KEY and GEMINI_MODEL (exact model id,
# pinned explicitly).
# The prompt goes on stdin, not -p: arm B carries all of PROTOCOL.md, which
# overflows the Windows command-line limit of the gemini.cmd shim.
# stream-json echoes the user prompt; runner.sh strips that echo symmetrically
# from for-grading.txt. smoke.sh must pass before this backend is admitted.
: "${GEMINI_API_KEY:?set GEMINI_API_KEY in secrets.env}"
: "${GEMINI_MODEL:?set GEMINI_MODEL in secrets.env}"
AB_MODEL="google:$GEMINI_MODEL"
AB_AGENT_CMD="gemini --yolo --output-format stream-json -m $GEMINI_MODEL"
